# Optional. Leave empty to keep telemetry off.
# If set, ClauseClear sends redacted traces only (category, risk, timings).
# Contract text, quotes, and filenames never leave the machine.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Local open-weight model served by Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma3:4b
